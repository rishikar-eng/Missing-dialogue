# Node / Vite
node_modules/
dist/
release/

# Python
__pycache__/
*.pyc
.venv/
venv/
build/
backend-dist/
*.spec.bak

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Episode data (multi-GB audio + vendor scripts — never commit)
episodes/
*.zip

# Large media + vendor reference material dropped in the repo root (kept local only).
# The committed voice data is the derived backend/data/voice_bank.json, not the xlsx.
*.wav
*.mp4
*.mov
*.mkv
*.xlsx
*.docx
*.pdf
vox-api-docs*.html
TECH_STACK*.md

# Local analysis scratch (per-episode VAD caches + ad-hoc test results in the repo root)
e[0-9]*_*.json
e[0-9]*_*.txt

# Local machine settings
.claude/settings.local.json

# Local secrets — NEVER commit (Teams webhook token, etc.)
# THIS REPO IS PUBLIC: anything committed here is world-readable, forever, even if
# deleted later (it stays in git history). Keep every credential out of it.
secrets.local.*
*.secret
# SSH private keys (e.g. the EC2 key) — comments must be on their OWN line here,
# a trailing comment becomes part of the pattern and silently fails to match.
*.pem
*.ppk
.env
.env.*
# ...and any *other* env file (server-keys.env, prod.env). The three patterns are NOT
# redundant: '.env*' misses 'server-keys.env' and '*.env' misses '.env.local'.
*.env
# studio voice-key exports etc.
*_keys.csv
groq.key
*.key

# API keys dropped in the repo root (public repo — never commit)
elevenlabs.txt
*_key.txt
*api_key*.txt
sarvam*.txt
*sarvam*.txt
